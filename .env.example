# ── Required ──────────────────────────────────────────────────────────────────
# Bot WhatsApp number (digits only, no + or spaces)
BOT_PHONE_NUMBER=2348012345678

# Your personal WhatsApp number (becomes the bot owner)
BOT_OWNER_PHONE=2348012345678

# Secret for signing web sessions (any long random string)
JWT_SECRET=change_me_to_a_long_random_secret

# Admin panel password (default: Flowers)
ADMIN_PASSWORD=Flowers

# ── Optional ──────────────────────────────────────────────────────────────────
# Extra owner numbers (comma-separated)
# OWNER_NUMBERS=2348012345678,2349012345678

# WhatsApp internal LID (not the phone number!)
# BOT_OWNER_LID=101014040526896

# For Echidna AI responses (get from openrouter.ai)
# OPENROUTER_API_KEY=sk-or-v1-...

# Your public deployment URL
# WEBSITE_URL=https://requiem-order.onrender.com

# ── Auto-set by Render ────────────────────────────────────────────────────────
PORT=10000
DATA_DIR=/data
NODE_ENV=production
